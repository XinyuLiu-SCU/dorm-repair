<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="materialRequestV2Definitions" targetNamespace="https://dormrepair.example/design-r2">
  <process id="materialRequestV2" name="材料领用（R2不可执行评审）" isExecutable="false">
    <documentation>DESIGN ONLY. No deployment. Delegate beans, actor/permission mapping, transaction logic and correlation are not implemented. Each collapsed scope has its own editable BPMNPlane.</documentation>
    <startEvent id="materialStart" name="独立申请启动">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </startEvent>
    <subProcess id="materialRequestScope" name="审批预留实发作用域">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      <startEvent id="materialScopeStart" name="申请">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </startEvent>
      <userTask id="approveMaterial" name="库存授权审批">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </userTask>
      <exclusiveGateway id="materialApprovalRoute" name="审批决定">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </exclusiveGateway>
      <serviceTask id="reserveMaterial" name="按锁序预留" flowable:delegateExpression="${r2ReviewOnlyDelegate}">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </serviceTask>
      <userTask id="issueMaterial" name="实际发料可分批">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </userTask>
      <exclusiveGateway id="materialQuantityRoute" name="净实发满足需求">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </exclusiveGateway>
      <serviceTask id="markMaterialReady" name="登记READY" flowable:delegateExpression="${r2ReviewOnlyDelegate}">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </serviceTask>
      <endEvent id="materialReadyEnd" name="完成资源准备">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </endEvent>
      <serviceTask id="denyMaterial" name="登记BLOCKED" flowable:delegateExpression="${r2ReviewOnlyDelegate}">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </serviceTask>
      <endEvent id="materialDeniedEnd" name="拒绝返回">
        <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
      </endEvent>
      <sequenceFlow id="materialRequestV2_f9" sourceRef="materialScopeStart" targetRef="approveMaterial" />
      <sequenceFlow id="materialRequestV2_f10" sourceRef="approveMaterial" targetRef="materialApprovalRoute" />
      <sequenceFlow id="materialRequestV2_f11" sourceRef="materialApprovalRoute" targetRef="reserveMaterial">
        <conditionExpression xsi:type="tFormalExpression">${materialApproved == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="materialRequestV2_f12" sourceRef="materialApprovalRoute" targetRef="denyMaterial">
        <conditionExpression xsi:type="tFormalExpression">${materialApproved == false}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="materialRequestV2_f13" sourceRef="reserveMaterial" targetRef="issueMaterial" />
      <sequenceFlow id="materialRequestV2_f14" sourceRef="issueMaterial" targetRef="materialQuantityRoute" />
      <sequenceFlow id="materialRequestV2_f15" sourceRef="materialQuantityRoute" targetRef="issueMaterial">
        <conditionExpression xsi:type="tFormalExpression">${materialQuantitySatisfied == false}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="materialRequestV2_f16" sourceRef="materialQuantityRoute" targetRef="markMaterialReady">
        <conditionExpression xsi:type="tFormalExpression">${materialQuantitySatisfied == true}</conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="materialRequestV2_f17" sourceRef="markMaterialReady" targetRef="materialReadyEnd" />
      <sequenceFlow id="materialRequestV2_f18" sourceRef="denyMaterial" targetRef="materialDeniedEnd" />
    </subProcess>
    <endEvent id="materialDone" name="材料结果返回调用者">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </endEvent>
    <serviceTask id="cancelMaterialCleanup" name="释放未发预留核对已发" flowable:delegateExpression="${r2ReviewOnlyDelegate}">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </serviceTask>
    <exclusiveGateway id="materialSettlementRoute" name="实发待核对">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </exclusiveGateway>
    <userTask id="materialSettlement" name="确认退料或交接">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </userTask>
    <serviceTask id="markMaterialBlocked" name="返回BLOCKED" flowable:delegateExpression="${r2ReviewOnlyDelegate}">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </serviceTask>
    <endEvent id="materialCancelled" name="取消结束">
      <documentation>R2 review node. Future service validates identity, order/task version, cycle and epoch. No runtime behavior is claimed.</documentation>
    </endEvent>
    <sequenceFlow id="materialRequestV2_f1" sourceRef="materialStart" targetRef="materialRequestScope" />
    <sequenceFlow id="materialRequestV2_f2" sourceRef="materialRequestScope" targetRef="materialDone" />
    <boundaryEvent id="materialCancelBoundary" name="materialCancelBoundary" attachedToRef="materialRequestScope" cancelActivity="true">
      <messageEventDefinition messageRef="cancelMaterialRequest" />
    </boundaryEvent>
    <sequenceFlow id="materialRequestV2_f3" sourceRef="materialCancelBoundary" targetRef="cancelMaterialCleanup" />
    <sequenceFlow id="materialRequestV2_f4" sourceRef="cancelMaterialCleanup" targetRef="materialSettlementRoute" />
    <sequenceFlow id="materialRequestV2_f5" sourceRef="materialSettlementRoute" targetRef="materialSettlement">
      <conditionExpression xsi:type="tFormalExpression">${materialSettlementRequired == true}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="materialRequestV2_f6" sourceRef="materialSettlementRoute" targetRef="markMaterialBlocked">
      <conditionExpression xsi:type="tFormalExpression">${materialSettlementRequired == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="materialRequestV2_f7" sourceRef="materialSettlement" targetRef="markMaterialBlocked" />
    <sequenceFlow id="materialRequestV2_f8" sourceRef="markMaterialBlocked" targetRef="materialCancelled" />
  </process>
  <message id="cancelMaterialRequest" name="cancelMaterialRequest" />
